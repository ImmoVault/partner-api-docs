meta {
  name: Get Consumption — Cold Water
  type: http
  seq: 8
}

get {
  url: https://api.sandbox.messpunkt.io/v1/usage-units/:id/consumption?from=2025-01-01&to=2025-12-31&metric=water_cold
  body: none
  auth: inherit
}

params:query {
  from: 2025-01-01
  to: 2025-12-31
  metric: water_cold
}

params:path {
  id: 280bb3c7-07db-4ef2-b0dc-9505096e676b
}

settings {
  encodeUrl: true
}

docs {
  # Consumption — water_cold (cold-water meter, single segment)

  Same contract as `consumption-water-warm`, but a simpler scenario: a
  single device segment with no replacement and no data gap. Good baseline
  to contrast against the meter-replacement response. Default unit is
  **WE 01** (Musterstraße 2-4), the same unit as the warm-water request.

  - `unit` is `m3`
  - `obis` is `null` (not populated, see the Reference)
  - Outdoor/garden water is a separate metric, `water_outdoor`, and is never
    folded into `water_cold`.
}
